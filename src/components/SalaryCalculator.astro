---
/**
 * Seção — Calculadora Salarial / Retorno do Diploma.
 * Baseada em dados da PNAD Contínua / IBGE (+45% Ensino Médio, +25% Fundamental).
 * Demonstração financeira em tempo real: o curso se paga no primeiro mês.
 */
import { APP_URL } from '../config';
import CtaButton from './CtaButton.astro';
---

<section id="calculadora-salarial" class="salary-calc section on-dark grain" aria-labelledby="calc-title" data-section="calculadora-salarial">
  <div class="container">
    <div class="calc-header text-center">
      <div class="kicker-badge" data-reveal>
        <svg viewBox="0 0 24 24" fill="none" class="badge-icon" aria-hidden="true">
          <path d="M23 6l-9.5 9.5-5-5L1 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M17 6h6v6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Impacto Financeiro Comprovado (IBGE)
      </div>
      <h2 id="calc-title" data-reveal style="--d: 1">
        Calcule o Retorno do seu <span class="text-accent">Diploma</span>
      </h2>
      <p class="calc-lead" data-reveal style="--d: 2">
        Concluir os estudos é a decisão mais lucrativa da sua vida. Veja quanto seu salário pode aumentar com o certificado oficial.
      </p>
    </div>

    <div class="calc-card" data-reveal style="--d: 3">
      <!-- Controles -->
      <div class="calc-controls">
        <div class="control-group">
          <label class="control-label" id="label-nivel">Objetivo de Conclusão:</label>
          <div class="calc-toggle" role="group" aria-labelledby="label-nivel">
            <button type="button" class="btn-toggle active" data-level="medio" aria-pressed="true">
              Ensino Médio (+45%)
            </button>
            <button type="button" class="btn-toggle" data-level="fundamental" aria-pressed="false">
              Fundamental (+25%)
            </button>
          </div>
        </div>

        <div class="control-group">
          <div class="slider-header">
            <label for="salary-slider" class="control-label">Sua renda mensal atual estimada:</label>
            <span class="salary-display" id="salary-val">R$ 1.600</span>
          </div>
          <input
            type="range"
            id="salary-slider"
            min="1000"
            max="6000"
            step="100"
            value="1600"
            class="range-input"
            aria-label="Renda mensal atual"
          />
          <div class="slider-ticks" aria-hidden="true">
            <span>R$ 1.000</span>
            <span>R$ 3.500</span>
            <span>R$ 6.000+</span>
          </div>
        </div>

        <div class="calc-tips">
          <p>• Diploma oficial abre portas para concursos públicos (médio e técnico).</p>
          <p>• Elegibilidade imediata para faculdade, cursos técnicos e promoção com carteira assinada.</p>
        </div>
      </div>

      <!-- Projeção -->
      <div class="calc-result">
        <div class="result-header">
          <span class="result-tag">Projeção Salarial Pós-Certificado</span>
          <div class="projected-amount">
            <span id="proj-val">R$ 2.320</span>
            <small>/mês</small>
          </div>
        </div>

        <div class="result-metrics">
          <div class="metric-item">
            <span class="metric-label">Ganho Extra / Mês</span>
            <div class="metric-val text-green" id="gain-month">+R$ 720</div>
          </div>
          <div class="metric-item">
            <span class="metric-label">Ganho Extra / Ano</span>
            <div class="metric-val text-yellow" id="gain-year">+R$ 8.640</div>
          </div>
        </div>

        <div class="result-action">
          <a href="#hero" class="btn btn-primary btn-calc" data-cta="calculadora-salario">
            Garantir Meu Aumento Salarial
            <svg viewBox="0 0 24 24" fill="none" class="btn-arrow" aria-hidden="true">
              <path d="M5 12h14m-6-6l6 6-6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <p class="result-footnote">
            A parcela do curso de R$ 99/mês se paga já no primeiro mês com seu diploma.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initSalaryCalculator() {
    const slider = document.getElementById('salary-slider') as HTMLInputElement | null;
    const salaryVal = document.getElementById('salary-val');
    const projVal = document.getElementById('proj-val');
    const gainMonth = document.getElementById('gain-month');
    const gainYear = document.getElementById('gain-year');
    const buttons = document.querySelectorAll<HTMLButtonElement>('.calc-toggle .btn-toggle');

    if (!slider || !salaryVal || !projVal || !gainMonth || !gainYear) return;

    let targetLevel: 'medio' | 'fundamental' = 'medio';

    function formatBRL(val: number): string {
      return 'R$ ' + val.toLocaleString('pt-BR');
    }

    function update() {
      const current = Number(slider?.value || 1600);
      const mult = targetLevel === 'medio' ? 1.45 : 1.25;
      const proj = Math.round(current * mult);
      const diffMonth = proj - current;
      const diffYear = diffMonth * 12;

      if (salaryVal) salaryVal.textContent = formatBRL(current);
      if (projVal) projVal.textContent = formatBRL(proj);
      if (gainMonth) gainMonth.textContent = '+' + formatBRL(diffMonth);
      if (gainYear) gainYear.textContent = '+' + formatBRL(diffYear);
    }

    slider.addEventListener('input', update);

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach((b) => {
          b.classList.remove('active');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-pressed', 'true');
        targetLevel = (btn.dataset.level as 'medio' | 'fundamental') || 'medio';
        update();
      });
    });

    update();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSalaryCalculator);
  } else {
    initSalaryCalculator();
  }
</script>

<style>
  .salary-calc {
    background: var(--ink);
    color: var(--paper);
    padding-block: clamp(4rem, 8vw, 6.5rem);
    position: relative;
    border-top: 1px solid rgb(255 255 255 / 0.1);
  }

  .calc-header {
    max-width: 52ch;
    margin-inline: auto;
    margin-bottom: clamp(2.5rem, 5vw, 3.8rem);
    text-align: center;
  }

  .kicker-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.9rem;
    border-radius: var(--radius-sm);
    background: rgb(0 156 59 / 0.15);
    border: 1px solid rgb(0 156 59 / 0.35);
    color: var(--green);
    font-size: 0.82rem;
    font-weight: 700;
    margin-bottom: 1.1rem;
  }

  .badge-icon {
    width: 1.1rem;
    height: 1.1rem;
  }

  .calc-header h2 {
    font-size: clamp(1.9rem, 1.3rem + 2.6vw, 3rem);
    line-height: 1.15;
    margin-bottom: 1rem;
  }

  .text-accent {
    color: var(--yellow);
  }

  .calc-lead {
    color: var(--muted-on-dark);
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.15rem);
  }

  .calc-card {
    background: rgb(255 255 255 / 0.04);
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: var(--radius-lg);
    padding: clamp(1.8rem, 4vw, 3rem);
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 4vw, 3rem);
    box-shadow: 0 16px 36px -8px rgb(0 0 0 / 0.4);
    backdrop-filter: blur(10px);
  }

  @media (min-width: 900px) {
    .calc-card {
      grid-template-columns: 1.1fr 1fr;
      align-items: center;
    }
  }

  .calc-controls {
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
  }

  .control-group {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .control-label {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--paper);
  }

  .calc-toggle {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.8rem;
  }

  .btn-toggle {
    background: rgb(255 255 255 / 0.08);
    border: 1px solid rgb(255 255 255 / 0.16);
    color: var(--muted-on-dark);
    padding: 0.8rem 1rem;
    border-radius: var(--radius-md);
    font-weight: 700;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.2s var(--ease-out);
  }

  .btn-toggle:hover {
    background: rgb(255 255 255 / 0.14);
    color: var(--paper);
  }

  .btn-toggle.active {
    background: var(--yellow);
    color: var(--ink);
    border-color: var(--yellow);
    box-shadow: 0 4px 14px rgb(255 223 0 / 0.25);
  }

  .slider-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .salary-display {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--yellow);
  }

  .range-input {
    width: 100%;
    height: 8px;
    border-radius: 4px;
    background: rgb(255 255 255 / 0.16);
    outline: none;
    accent-color: var(--yellow);
    cursor: pointer;
  }

  .slider-ticks {
    display: flex;
    justify-content: space-between;
    font-size: 0.78rem;
    color: var(--muted-on-dark);
  }

  .calc-tips {
    padding: 1rem 1.2rem;
    border-radius: var(--radius-md);
    background: rgb(255 255 255 / 0.03);
    border: 1px solid rgb(255 255 255 / 0.08);
    font-size: 0.82rem;
    color: var(--muted-on-dark);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .calc-result {
    background: linear-gradient(145deg, rgb(0 156 59 / 0.18), rgb(0 39 118 / 0.28));
    border: 1px solid rgb(0 156 59 / 0.4);
    border-radius: var(--radius-lg);
    padding: clamp(1.8rem, 3.5vw, 2.4rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .result-header {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .result-tag {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--green);
  }

  .projected-amount {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.6rem + 2vw, 2.8rem);
    font-weight: 700;
    color: #ffffff;
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
  }

  .projected-amount small {
    font-size: 0.95rem;
    color: var(--muted-on-dark);
    font-family: var(--font-body);
    font-weight: 400;
  }

  .result-metrics {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    padding-block: 1.1rem;
    border-block: 1px solid rgb(255 255 255 / 0.12);
  }

  .metric-label {
    font-size: 0.8rem;
    color: var(--muted-on-dark);
  }

  .metric-val {
    font-size: 1.25rem;
    font-weight: 700;
    margin-top: 0.2rem;
  }

  .text-green {
    color: #4ade80;
  }

  .text-yellow {
    color: var(--yellow);
  }

  .btn-calc {
    width: 100%;
    justify-content: center;
    padding-block: 1rem;
    font-size: 1.05rem;
    background: var(--green);
    color: #ffffff;
    box-shadow: 0 4px 18px rgb(0 156 59 / 0.35);
  }

  .btn-calc:hover {
    background: #00b344;
  }

  .btn-arrow {
    width: 1.2rem;
    height: 1.2rem;
  }

  .result-footnote {
    font-size: 0.78rem;
    color: var(--muted-on-dark);
    text-align: center;
    margin-top: 0.6rem;
  }
</style>
