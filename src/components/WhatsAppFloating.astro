---
/**
 * Componente — Botão Flutuante de Atendimento WhatsApp
 * Com suporte a popover interativo, captura dinâmica de ref de afiliado
 * (via localStorage/cookie) e link direto para wa.me.
 */
import { APP_URL, WHATSAPP_NUMBER } from '../config';

const defaultMessage =
  'Olá! Vim pelo site e quero tirar dúvidas sobre a matrícula rápida no Supletivo Brasil.';
const defaultWaUrl = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(defaultMessage)}`;
---

<aside
  class="wa-floating-wrap"
  aria-label="Atendimento via WhatsApp"
>
  <!-- Popover do WhatsApp -->
  <div
    id="wa-popover"
    class="wa-popover"
    role="dialog"
    aria-labelledby="wa-popover-title"
    aria-modal="false"
    hidden
  >
    <div class="wa-popover-header">
      <div class="wa-agent-info">
        <div class="wa-avatar">
          <span>SB</span>
          <span class="wa-status-dot" aria-hidden="true"></span>
        </div>
        <div>
          <h4 id="wa-popover-title" class="wa-agent-name">Plantão de Dúvidas</h4>
          <p class="wa-agent-role">Atendimento Pedagógico Oficial</p>
        </div>
      </div>
      <button
        type="button"
        id="wa-close-btn"
        class="wa-close-btn"
        aria-label="Fechar janela de atendimento"
      >
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></line>
          <line x1="6" y1="6" x2="18" y2="18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></line>
        </svg>
      </button>
    </div>

    <div class="wa-popover-body">
      <div class="wa-balloon">
        <p>
          👋 Olá! Tem alguma dúvida sobre a publicação no <strong>Diário Oficial</strong> ou sobre o prazo de conclusão do seu <strong>Ensino Fundamental ou Médio</strong>?
        </p>
        <span class="wa-time" id="wa-time-display">Agora mesmo</span>
      </div>

      <div class="wa-actions">
        <a
          id="wa-direct-link"
          href={defaultWaUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="wa-send-btn"
        >
          <svg class="wa-icon-send" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <line x1="22" y1="2" x2="11" y2="13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></line>
            <polygon points="22 2 15 22 11 13 2 9 22 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></polygon>
          </svg>
          Chamar no WhatsApp
        </a>

        <a
          href={APP_URL}
          class="wa-portal-btn"
          data-cta="whatsapp-popup"
        >
          Ir Direto para a Matrícula
        </a>
      </div>
    </div>
  </div>

  <!-- Botão Gatilho Redondo Flutuante -->
  <button
    type="button"
    id="wa-toggle-btn"
    class="wa-trigger-btn"
    aria-label="Abrir atendimento via WhatsApp"
    aria-haspopup="dialog"
    aria-expanded="false"
  >
    <svg class="wa-icon-main" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.23 8.23 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.64c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.02-1.25-.75-.67-1.26-1.5-1.4-1.75-.15-.25-.02-.39.11-.51.11-.11.25-.29.38-.44.13-.14.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.34-.76-1.84-.2-.49-.4-.42-.56-.43h-.47c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.24.9 2.44 1.03 2.61.13.17 1.78 2.71 4.3 3.8 2.53 1.09 2.53.73 2.99.69.45-.04 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.11-.22-.17-.47-.29z"></path>
    </svg>
    <span class="wa-badge" aria-label="1 nova notificação">
      <span class="wa-badge-ping" aria-hidden="true"></span>
      <span class="wa-badge-text">1</span>
    </span>
  </button>
</aside>

<script>
  function initWhatsAppWidget() {
    const toggleBtn = document.querySelector<HTMLButtonElement>('#wa-toggle-btn');
    const popover = document.querySelector<HTMLElement>('#wa-popover');
    const closeBtn = document.querySelector<HTMLButtonElement>('#wa-close-btn');
    const waLink = document.querySelector<HTMLAnchorElement>('#wa-direct-link');

    if (!toggleBtn || !popover) return;

    // Resolve ref de afiliado existente para anexar na mensagem
    let affiliateRef = '';
    try {
      const stored = localStorage.getItem('sb_attribution');
      if (stored) {
        const parsed = JSON.parse(stored);
        if (parsed.ref) affiliateRef = parsed.ref;
      }
      if (!affiliateRef) {
        const cookieMatch = document.cookie.match(/(?:^|;\s*)sb_ref=([^;]+)/);
        if (cookieMatch) affiliateRef = decodeURIComponent(cookieMatch[1]);
      }
      if (!affiliateRef) {
        const params = new URLSearchParams(window.location.search);
        const urlRef = params.get('ref');
        if (urlRef) affiliateRef = urlRef;
      }
    } catch {
      /* fallback limpo */
    }

    if (affiliateRef && waLink) {
      const msg = `Olá! Vim pelo site (ref: ${affiliateRef}) e quero tirar dúvidas sobre a matrícula rápida no Supletivo Brasil.`;
      const url = new URL(waLink.href);
      url.searchParams.set('text', msg);
      waLink.href = url.toString();
    }

    function openPopover() {
      popover.hidden = false;
      popover.classList.add('is-open');
      toggleBtn.setAttribute('aria-expanded', 'true');
    }

    function closePopover() {
      popover.classList.remove('is-open');
      popover.hidden = true;
      toggleBtn.setAttribute('aria-expanded', 'false');
    }

    toggleBtn.addEventListener('click', () => {
      if (popover.hidden) {
        openPopover();
      } else {
        closePopover();
      }
    });

    closeBtn?.addEventListener('click', closePopover);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !popover.hidden) {
        closePopover();
        toggleBtn.focus();
      }
    });

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!popover.hidden && !popover.contains(target) && !toggleBtn.contains(target)) {
        closePopover();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initWhatsAppWidget);
  } else {
    initWhatsAppWidget();
  }
</script>

<style>
  .wa-floating-wrap {
    position: fixed;
    right: clamp(1rem, 3vw, 1.8rem);
    bottom: clamp(1.2rem, 3vw, 1.8rem);
    z-index: 60;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  /* Ajuste no mobile para não sobrepor a barra StickyCta */
  @media (max-width: 899px) {
    .wa-floating-wrap {
      bottom: 5rem;
    }
  }

  /* Popover Dialog */
  .wa-popover {
    width: min(calc(100vw - 2.5rem), 21.5rem);
    background: var(--paper);
    border-radius: var(--radius-lg);
    box-shadow: 0 20px 50px -15px rgb(11 18 32 / 0.35);
    border: 1px solid var(--line-light);
    margin-bottom: 0.9rem;
    overflow: clip;
    transition:
      transform 0.25s var(--ease-out),
      opacity 0.2s var(--ease-out);
  }

  .wa-popover[hidden] {
    display: none;
  }

  .wa-popover.is-open {
    display: block;
    animation: wa-slide-up 0.3s var(--ease-out);
  }

  @keyframes wa-slide-up {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .wa-popover-header {
    background: linear-gradient(135deg, #00734d, #005238);
    color: var(--paper);
    padding: 0.9rem 1.1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .wa-agent-info {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .wa-avatar {
    position: relative;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.2);
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: 0.85rem;
    color: var(--yellow);
  }

  .wa-status-dot {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: #22c55e;
    border: 2px solid #005238;
  }

  .wa-agent-name {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.92rem;
    line-height: 1.2;
    margin: 0;
  }

  .wa-agent-role {
    font-size: 0.72rem;
    color: rgb(255 255 255 / 0.82);
    margin-top: 0.15rem;
  }

  .wa-close-btn {
    background: none;
    border: none;
    color: rgb(255 255 255 / 0.75);
    width: 1.8rem;
    height: 1.8rem;
    padding: 0.25rem;
    cursor: pointer;
    border-radius: 50%;
    transition: color 0.15s;
  }

  .wa-close-btn:hover {
    color: var(--paper);
  }

  .wa-popover-body {
    padding: 1.1rem;
    background: var(--paper-soft);
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .wa-balloon {
    background: var(--paper);
    padding: 0.85rem 1rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--line-light);
    font-size: 0.86rem;
    line-height: 1.45;
    color: var(--ink);
    box-shadow: 0 4px 12px -4px rgb(11 18 32 / 0.05);
  }

  .wa-time {
    display: block;
    font-size: 0.68rem;
    color: var(--muted-on-light);
    text-align: right;
    margin-top: 0.4rem;
  }

  .wa-actions {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .wa-send-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: #00734d;
    color: var(--paper);
    font-weight: 700;
    font-size: 0.88rem;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    box-shadow: 0 6px 18px -4px rgb(0 115 77 / 0.4);
    transition: all 0.2s var(--ease-out);
  }

  .wa-send-btn:hover {
    background: #005238;
    transform: translateY(-1px);
    box-shadow: 0 8px 22px -4px rgb(0 115 77 / 0.5);
  }

  .wa-icon-send {
    width: 0.95rem;
    height: 0.95rem;
    flex: none;
  }

  .wa-portal-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--paper);
    color: var(--ink);
    border: 1px solid var(--line-light);
    font-weight: 700;
    font-size: 0.82rem;
    padding: 0.65rem 1rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all 0.2s;
  }

  .wa-portal-btn:hover {
    background: var(--line-light);
  }

  /* Botão Gatilho Flutuante */
  .wa-trigger-btn {
    width: 3.6rem;
    height: 3.6rem;
    border-radius: 50%;
    background: linear-gradient(135deg, #25d366, #128c7e);
    color: #ffffff;
    border: none;
    cursor: pointer;
    box-shadow:
      0 8px 24px -4px rgb(18 140 126 / 0.5),
      0 2px 6px -1px rgb(0 0 0 / 0.15);
    display: grid;
    place-items: center;
    position: relative;
    transition:
      transform 0.2s var(--ease-out),
      box-shadow 0.2s var(--ease-out);
  }

  .wa-trigger-btn:hover {
    transform: scale(1.08);
    box-shadow: 0 12px 28px -4px rgb(18 140 126 / 0.65);
  }

  .wa-trigger-btn:active {
    transform: scale(0.95);
  }

  .wa-icon-main {
    width: 1.85rem;
    height: 1.85rem;
  }

  .wa-badge {
    position: absolute;
    top: -2px;
    right: -2px;
    width: 1.25rem;
    height: 1.25rem;
    display: grid;
    place-items: center;
  }

  .wa-badge-ping {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--yellow);
    opacity: 0.75;
    animation: wa-ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  .wa-badge-text {
    position: relative;
    width: 1.15rem;
    height: 1.15rem;
    border-radius: 50%;
    background: var(--yellow);
    color: var(--ink);
    font-size: 0.72rem;
    font-weight: 700;
    display: grid;
    place-items: center;
    line-height: 1;
  }

  @keyframes wa-ping {
    75%,
    100% {
      transform: scale(2);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-badge-ping {
      animation: none;
    }
    .wa-popover.is-open {
      animation: none;
    }
  }
</style>
