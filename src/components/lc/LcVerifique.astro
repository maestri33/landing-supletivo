---
/**
 * Verifique antes de decidir (seção 7.7 do handoff): converte desconfiança
 * em verificação prática. <details> nativos (funcionam sem JS);
 * abertura dispara trust_opened (seção 14).
 */
import { APP_URL } from '../../config';

const itens = [
  {
    id: 'quem-atende',
    q: 'Quem atende você',
    a: 'O Supletivo Brasil é uma plataforma da V7M. Os dados institucionais, o CNPJ e os canais oficiais estão no rodapé desta página e na política de atendimento — confira antes de qualquer pagamento.',
  },
  {
    id: 'documentos',
    q: 'Quais documentos serão exigidos',
    a: 'A lista depende da etapa e do seu histórico. Você recebe a lista do seu caso antes de concluir a matrícula — nenhuma cobrança acontece sem que você saiba o que será exigido.',
  },
  {
    id: 'cada-etapa',
    q: 'Como funciona cada etapa',
    a: 'Estudo 100% online no seu ritmo e prova final presencial em polo, com data escolhida por você. A certificação é emitida por instituição parceira credenciada ao MEC, com validade nacional (Lei nº 9.394/96, LDB).',
  },
  {
    id: 'depois-da-matricula',
    q: 'O que continua disponível depois da matrícula',
    a: 'O acesso ao app, à trilha de estudos e ao atendimento humano. Os canais de suporte não desaparecem depois do pagamento.',
  },
  {
    id: 'antes-de-pagar',
    q: 'Como tirar dúvidas antes de pagar',
    a: 'Pelo atendimento oficial, acessível nesta página e no app. Se qualquer informação de preço ou condição parecer divergente, pergunte antes de confirmar.',
  },
  {
    id: 'problema',
    q: 'Como registrar um problema',
    a: 'Pelo mesmo canal oficial de atendimento. Compras pela internet têm 7 dias de arrependimento com devolução integral, conforme o art. 49 do Código de Defesa do Consumidor.',
  },
];
---

<section
  id="verifique"
  class="lc-verifique section"
  aria-labelledby="lc-verifique-title"
  data-lc-section="verifique"
>
  <div class="container narrow">
    <p class="lc-milestone" data-reveal>6 · Verificação</p>
    <h2 id="lc-verifique-title" class="lc-h2" data-reveal>Não confie só em uma promessa</h2>
    <p class="lc-lead" data-reveal style="--d: 1">
      Confira quem atende você, quais documentos serão exigidos, como funciona cada etapa e quais
      canais continuam disponíveis depois da matrícula.
    </p>

    <div class="lc-trust-list">
      {
        itens.map((item, i) => (
          <details class="lc-trust-item" data-trust={item.id} data-reveal style={`--d: ${Math.min(i, 3)}`}>
            <summary>
              <span>{item.q}</span>
              <svg
                class="chev"
                viewBox="0 0 24 24"
                width="20"
                height="20"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M6 9l6 6 6-6"
                  stroke="currentColor"
                  stroke-width="2.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>

    <div class="lc-verifique-cta" data-reveal>
      <a class="lc-btn-ghost" href={APP_URL} data-cta="verifique-atendimento">
        Tirar uma dúvida com o atendimento →
      </a>
    </div>
  </div>
</section>

<style>
  .lc-verifique {
    background: var(--lc-paper);
  }

  .lc-verifique .lc-lead {
    margin-top: 1.2rem;
  }

  .lc-trust-list {
    margin-top: 2.2rem;
    display: grid;
    gap: 0.8rem;
  }

  .lc-trust-item {
    background: var(--lc-paper-soft);
    border: 1px solid var(--lc-line-soft);
    border-radius: 14px;
  }

  .lc-trust-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.05rem 1.25rem;
    cursor: pointer;
    list-style: none;
    touch-action: manipulation;
    font-weight: 700;
    color: var(--lc-blue);
    border-radius: 14px;
  }

  .lc-trust-item summary::-webkit-details-marker {
    display: none;
  }

  .lc-trust-item summary:focus-visible {
    outline: 3px solid var(--lc-blue);
    outline-offset: -3px;
  }

  .lc-trust-item .chev {
    flex: none;
    color: var(--lc-green-deep);
    transition: transform 0.25s var(--ease-out);
  }

  .lc-trust-item[open] .chev {
    transform: rotate(180deg);
  }

  .lc-trust-item > p {
    padding: 0 1.25rem 1.15rem;
    color: var(--lc-muted);
  }

  .lc-verifique-cta {
    margin-top: 1.6rem;
  }
</style>
