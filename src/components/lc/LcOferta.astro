---
/**
 * Oferta (seção 7.8 do handoff): valor e regra sem pressão enganosa.
 * DECISÕES PENDENTES (seção 2 do handoff): quantidade X, evento de
 * confirmação e o preço de referência de R$ 1.615 NÃO são exibidos
 * enquanto OFFER estiver com campos null (ver src/data/linha-continua.ts).
 * Sem contador, sem cronômetro, sem "vagas" (limitação é comercial).
 */
import { APP_URL } from '../../config';
import { offerRuleText, OFFER } from '../../data/linha-continua';
import { pixBRL, cardLine, brl, PRICE } from '../../data/price';

const rule = offerRuleText();
---

<section id="oferta" class="lc-oferta section" aria-labelledby="lc-oferta-title" data-lc-section="oferta">
  <div class="container narrow">
    <p class="lc-milestone" data-reveal>7 · Condição</p>

    <div class="lc-offer-card" data-reveal>
      <p class="lc-offer-seal">Condição de lançamento</p>
      <h2 id="lc-oferta-title">
        <span class="lc-offer-price">{pixBRL}</span>
        <span class="lc-offer-pix">no Pix</span>
      </h2>
      <p class="lc-offer-card-alt">ou {cardLine} no cartão de crédito</p>

      {
        /* [VALIDAR — Financeiro + Jurídico] preço de referência só aparece
           depois de comprovado (bloqueador 3 da seção 2 do handoff) */
        OFFER.referencePriceApproved && (
          <p class="lc-offer-ref">de {brl(PRICE.full)} por {pixBRL}</p>
        )
      }

      <p class="lc-offer-rule">{rule}</p>

      <ul class="lc-offer-includes">
        <li>Estudo 100% online, pelo celular, no seu ritmo</li>
        <li>Trilha orientada com acompanhamento e suporte no app</li>
        <li>Prova final presencial em polo, com data escolhida por você</li>
        <li>Certificação por instituição parceira credenciada ao MEC</li>
        <li>Documentação oficial conduzida até a Secretaria de Educação</li>
      </ul>

      <a class="lc-btn lc-btn-xl" href={APP_URL} data-cta="oferta-comecar" data-offer-cta>
        Começar minha matrícula
        <svg class="btn-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M5 12h14m-6-6 6 6-6 6"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
      <p class="microcopy" style="color: var(--lc-muted)">
        Você segue para o app de matrícula (app.supletivo.net.br) e confirma preço e condição antes
        de pagar.
      </p>
      <p class="lc-offer-terms">
        <a href="/termos">Termos aplicáveis</a> · <a href="/privacidade">Privacidade</a>
      </p>
    </div>
  </div>
</section>

<style>
  .lc-oferta {
    background: var(--lc-paper-soft);
  }

  .lc-offer-card {
    margin-top: 1.6rem;
    background: #fff;
    border: 2px solid var(--lc-blue);
    border-radius: var(--radius-lg);
    padding: clamp(1.6rem, 1.2rem + 2vw, 2.6rem);
    text-align: center;
  }

  .lc-offer-seal {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--lc-blue);
    background: var(--lc-yellow);
    border-radius: 999px;
    padding: 0.45rem 1.1rem;
  }

  .lc-offer-card h2 {
    margin-top: 1.2rem;
  }

  .lc-offer-price {
    font-family: var(--font-display);
    font-size: var(--text-price);
    color: var(--lc-blue);
  }

  .lc-offer-pix {
    display: block;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--lc-green-deep);
    margin-top: 0.2rem;
  }

  .lc-offer-card-alt {
    margin-top: 0.5rem;
    color: var(--lc-muted);
  }

  .lc-offer-ref {
    margin-top: 0.4rem;
    color: var(--lc-muted);
  }

  .lc-offer-rule {
    margin: 1.2rem auto 0;
    max-width: 44ch;
    font-size: 0.95rem;
    color: var(--lc-muted);
    border-top: 1px dashed var(--lc-line-soft);
    padding-top: 1.1rem;
  }

  .lc-offer-includes {
    list-style: none;
    padding: 0;
    margin: 1.6rem auto 0;
    max-width: 34rem;
    text-align: left;
    display: grid;
    gap: 0.55rem;
  }

  .lc-offer-includes li {
    position: relative;
    padding-left: 1.6rem;
    color: var(--lc-ink);
  }

  .lc-offer-includes li::before {
    content: '✓';
    position: absolute;
    left: 0;
    font-weight: 700;
    color: var(--lc-green);
  }

  .lc-offer-card .lc-btn {
    margin-top: 1.8rem;
  }

  .lc-offer-card .microcopy {
    max-width: 40ch;
    margin-inline: auto;
  }

  .lc-offer-terms {
    margin-top: 1rem;
    font-size: 0.85rem;
  }

  .lc-offer-terms a {
    color: var(--lc-blue);
    text-underline-offset: 3px;
  }
</style>
