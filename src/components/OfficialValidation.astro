---
/**
 * Componente — Consulta e Validador de Diário Oficial por Estado
 * Permite ao candidato selecionar sua UF e verificar o órgão regulador (CEE),
 * os prazos de publicação e o amparo legal segundo o Art. 38 da LDB.
 */
import { APP_URL } from '../config';

const BRAZILIAN_STATES = [
  { uf: 'SP', name: 'São Paulo', cee: 'CEE-SP / Parecer Normativo', prazos: '30 a 60 dias' },
  { uf: 'RJ', name: 'Rio de Janeiro', cee: 'CEE-RJ / Resolução Vigente', prazos: '30 a 60 dias' },
  { uf: 'MG', name: 'Minas Gerais', cee: 'CEE-MG / Portaria Estadual', prazos: '30 a 60 dias' },
  { uf: 'BA', name: 'Bahia', cee: 'CEE-BA / Homologação Oficial', prazos: '45 a 60 dias' },
  { uf: 'PR', name: 'Paraná', cee: 'CEE-PR / Amparo Legal', prazos: '30 a 45 dias' },
  { uf: 'RS', name: 'Rio Grande do Sul', cee: 'CEE-RS / Parecer Estadual', prazos: '30 a 60 dias' },
  { uf: 'PE', name: 'Pernambuco', cee: 'CEE-PE / Registro Nominal', prazos: '45 a 60 dias' },
  { uf: 'CE', name: 'Ceará', cee: 'CEE-CE / Portaria EJA', prazos: '30 a 60 dias' },
  { uf: 'GO', name: 'Goiás', cee: 'CEE-GO / Sistema Estadual', prazos: '30 a 45 dias' },
  { uf: 'DF', name: 'Distrito Federal', cee: 'SEEDF / Diário Oficial do DF', prazos: '30 a 45 dias' },
  { uf: 'SC', name: 'Santa Catarina', cee: 'CEE-SC / Homologação', prazos: '30 a 45 dias' },
  { uf: 'OUTRO', name: 'Demais Estados (Todo o Brasil)', cee: 'Validade Nacional (LDB 9.394/96 Art. 38)', prazos: '30 a 60 dias' },
];

const defaultState = BRAZILIAN_STATES[0];
const validationUrl = `${APP_URL}/validar`;
---

<section
  id="validacao-oficial"
  class="official-val section on-dark grain"
  aria-labelledby="val-title"
  data-section="validacao-oficial"
>
  <div class="container">
    <div class="val-header" data-reveal>
      <div class="val-badge">
        <svg class="val-badge-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          <path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <span>Amparo Jurídico & Diário Oficial</span>
      </div>
      <h2 id="val-title">
        Seu certificado é <span class="hl">100% oficial</span>, com publicação nominal no Diário Oficial.
      </h2>
      <p class="val-lead">
        Não é curso livre. É conclusão oficial amparada pelo <strong>Artigo 38 da Lei Federal nº 9.394/96 (LDB)</strong>. Você pode prestar qualquer concurso público, ingressar na faculdade e apresentar para promoções em empresas.
      </p>
    </div>

    <div class="val-grid">
      <!-- Painel Interativo de Verificação -->
      <div class="val-card-main" data-reveal style="--d: 1">
        <div class="val-card-header">
          <div class="val-card-title-wrap">
            <svg class="val-title-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
              <circle cx="12" cy="10" r="3" stroke="currentColor" stroke-width="2"></circle>
            </svg>
            <h3 class="val-card-title">Consulta de Registro Estadual</h3>
          </div>
          <div class="val-select-wrap">
            <label for="uf-select" class="val-select-label">Seu Estado:</label>
            <select id="uf-select" class="uf-dropdown" aria-label="Selecione o seu estado">
              {BRAZILIAN_STATES.map((state) => (
                <option value={state.uf}>
                  {state.uf} — {state.name}
                </option>
              ))}
            </select>
          </div>
        </div>

        <div class="val-metrics" aria-live="polite">
          <div class="metric-box">
            <span class="metric-label">Órgão Regulador</span>
            <strong class="metric-value metric-hl" id="state-cee">{defaultState.cee}</strong>
          </div>
          <div class="metric-box">
            <span class="metric-label">Prazo de Emissão</span>
            <strong class="metric-value" id="state-prazos">{defaultState.prazos}</strong>
          </div>
          <div class="metric-box">
            <span class="metric-label">Validade Territorial</span>
            <strong class="metric-value metric-yellow">Nacional (Todo Brasil)</strong>
          </div>
        </div>

        <div class="val-assurances">
          <div class="assurance-item">
            <svg class="check-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.8"></circle>
              <path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            <p>
              <strong>Publicação Nominal:</strong> Seu nome, CPF e número de registro saem no Diário Oficial do Estado para consulta pública permanente.
            </p>
          </div>
          <div class="assurance-item">
            <svg class="check-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.8"></circle>
              <path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            <p>
              <strong>Código de Autenticidade Digital:</strong> Certificado emitido com QR Code e chave criptográfica de validação instantânea no portal.
            </p>
          </div>
          <div class="assurance-item">
            <svg class="check-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.8"></circle>
              <path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            <p>
              <strong>Histórico Escolar Completo:</strong> Documento timbrado com notas por disciplina, ementa e carga horária obrigatória.
            </p>
          </div>
        </div>

        <div class="val-actions">
          <a
            href={validationUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="val-link"
          >
            <svg class="ext-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M15 3h6v6m-11 5L21 3m-3 10v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            <span>Acessar Portal Oficial de Consulta no app.supletivo.net.br</span>
          </a>
          <a
            href={APP_URL}
            class="btn btn-val"
            data-cta="validacao-matricula"
          >
            Iniciar Matrícula com Garantia Jurídica
            <svg class="btn-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Card Lateral de Aceitação -->
      <aside class="val-card-side" data-reveal style="--d: 2">
        <div class="side-icon-wrap" aria-hidden="true">
          <svg class="file-icon" viewBox="0 0 24 24" fill="none">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
            <polyline points="14 2 14 8 20 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></polyline>
            <path d="m9 15 2 2 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </div>
        <h4 class="side-title">Aceito Onde Você Precisar:</h4>
        <ul class="side-list">
          <li>
            <span class="side-bullet" aria-hidden="true"></span>
            <span>Faculdades e Universidades (MEC)</span>
          </li>
          <li>
            <span class="side-bullet" aria-hidden="true"></span>
            <span>Concursos Públicos Municipais, Estaduais e Federais</span>
          </li>
          <li>
            <span class="side-bullet" aria-hidden="true"></span>
            <span>Cursos Técnicos e Profissionalizantes</span>
          </li>
          <li>
            <span class="side-bullet" aria-hidden="true"></span>
            <span>Promoção de Cargo e Vagas CLT</span>
          </li>
        </ul>
        <div class="side-alert">
          <span class="alert-bolt" aria-hidden="true">⚡</span>
          <span>Sem pegadinhas. Seu diploma é emitido por instituição credenciada pelos Conselhos de Educação.</span>
        </div>
      </aside>
    </div>
  </div>
</section>

<script>
  const STATES_DATA: Record<string, { cee: string; prazos: string }> = {
    SP: { cee: 'CEE-SP / Parecer Normativo', prazos: '30 a 60 dias' },
    RJ: { cee: 'CEE-RJ / Resolução Vigente', prazos: '30 a 60 dias' },
    MG: { cee: 'CEE-MG / Portaria Estadual', prazos: '30 a 60 dias' },
    BA: { cee: 'CEE-BA / Homologação Oficial', prazos: '45 a 60 dias' },
    PR: { cee: 'CEE-PR / Amparo Legal', prazos: '30 a 45 dias' },
    RS: { cee: 'CEE-RS / Parecer Estadual', prazos: '30 a 60 dias' },
    PE: { cee: 'CEE-PE / Registro Nominal', prazos: '45 a 60 dias' },
    CE: { cee: 'CEE-CE / Portaria EJA', prazos: '30 a 60 dias' },
    GO: { cee: 'CEE-GO / Sistema Estadual', prazos: '30 a 45 dias' },
    DF: { cee: 'SEEDF / Diário Oficial do DF', prazos: '30 a 45 dias' },
    SC: { cee: 'CEE-SC / Homologação', prazos: '30 a 45 dias' },
    OUTRO: { cee: 'Validade Nacional (LDB 9.394/96 Art. 38)', prazos: '30 a 60 dias' },
  };

  function initOfficialValidation() {
    const select = document.querySelector<HTMLSelectElement>('#uf-select');
    const ceeEl = document.querySelector<HTMLElement>('#state-cee');
    const prazosEl = document.querySelector<HTMLElement>('#state-prazos');

    if (!select || !ceeEl || !prazosEl) return;

    select.addEventListener('change', () => {
      const selected = STATES_DATA[select.value] || STATES_DATA['SP'];
      ceeEl.textContent = selected.cee;
      prazosEl.textContent = selected.prazos;
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initOfficialValidation);
  } else {
    initOfficialValidation();
  }
</script>

<style>
  .official-val {
    background:
      radial-gradient(50rem 32rem at 80% 100%, rgb(0 115 77 / 0.15), transparent 70%),
      var(--ink);
    color: var(--paper);
    overflow: clip;
  }

  .official-val .sec-num {
    color: var(--paper);
  }

  .val-header {
    max-width: 48rem;
    margin-bottom: 2.8rem;
  }

  .val-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    background: rgb(0 115 77 / 0.2);
    border: 1px solid rgb(0 115 77 / 0.5);
    color: #4ade80;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 1.2rem;
  }

  .val-badge-icon {
    width: 1.05rem;
    height: 1.05rem;
  }

  .hl {
    color: var(--yellow);
  }

  .val-lead {
    color: var(--muted-on-dark);
    font-size: var(--text-lg);
    margin-top: 1.1rem;
    line-height: 1.6;
  }

  .val-lead strong {
    color: var(--paper);
  }

  .val-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.8rem;
    align-items: start;
  }

  @media (min-width: 980px) {
    .val-grid {
      grid-template-columns: 1.85fr 1fr;
      gap: 2.2rem;
    }
  }

  .val-card-main {
    background:
      linear-gradient(180deg, var(--ink-soft), var(--ink));
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: var(--radius-lg);
    padding: clamp(1.4rem, 4vw, 2.5rem);
    box-shadow: 0 20px 48px -18px rgb(0 0 0 / 0.45);
  }

  .val-card-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1.8rem;
  }

  @media (min-width: 600px) {
    .val-card-header {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .val-card-title-wrap {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .val-title-icon {
    width: 1.4rem;
    height: 1.4rem;
    color: var(--yellow);
    flex: none;
  }

  .val-card-title {
    font-size: var(--text-h3);
    font-weight: 700;
  }

  .val-select-wrap {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .val-select-label {
    font-size: 0.82rem;
    color: var(--muted-on-dark);
    font-weight: 600;
  }

  .uf-dropdown {
    background: var(--ink);
    border: 1px solid rgb(255 255 255 / 0.25);
    border-radius: var(--radius-sm);
    color: var(--paper);
    font-family: var(--font-body);
    font-size: 0.88rem;
    font-weight: 700;
    padding: 0.55rem 0.9rem;
    cursor: pointer;
    outline: none;
    transition: border-color 0.2s;
  }

  .uf-dropdown:focus-visible {
    border-color: var(--yellow);
    outline: 2px solid var(--yellow);
  }

  .val-metrics {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.9rem;
    margin-bottom: 1.8rem;
  }

  @media (min-width: 600px) {
    .val-metrics {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .metric-box {
    background: rgb(255 255 255 / 0.04);
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: var(--radius-md);
    padding: 1rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .metric-label {
    font-size: 0.76rem;
    color: var(--muted-on-dark);
    font-weight: 600;
  }

  .metric-value {
    font-size: 0.94rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .metric-hl {
    color: #4ade80;
  }

  .metric-yellow {
    color: var(--yellow);
  }

  .val-assurances {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    font-size: 0.9rem;
    color: var(--muted-on-dark);
    line-height: 1.5;
  }

  .assurance-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .assurance-item strong {
    color: var(--paper);
  }

  .check-icon {
    width: 1.25rem;
    height: 1.25rem;
    color: #4ade80;
    flex: none;
    margin-top: 0.15rem;
  }

  .val-actions {
    margin-top: 2rem;
    padding-top: 1.6rem;
    border-top: 1px solid rgb(255 255 255 / 0.1);
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  @media (min-width: 640px) {
    .val-actions {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .val-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: var(--muted-on-dark);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s;
  }

  .val-link:hover {
    color: #4ade80;
  }

  .ext-icon {
    width: 0.95rem;
    height: 0.95rem;
    flex: none;
  }

  .btn-val {
    font-size: 0.95rem;
    padding: 0.95em 1.6em;
  }

  /* Card Lateral */
  .val-card-side {
    background:
      radial-gradient(circle at 100% 0%, rgb(0 115 77 / 0.25), transparent 70%),
      rgb(0 82 56 / 0.3);
    border: 1px solid rgb(0 115 77 / 0.45);
    border-radius: var(--radius-lg);
    padding: clamp(1.4rem, 3.5vw, 2.2rem);
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .side-icon-wrap {
    width: 3.2rem;
    height: 3.2rem;
    color: #4ade80;
  }

  .file-icon {
    width: 100%;
    height: 100%;
  }

  .side-title {
    font-size: 1.18rem;
    font-weight: 700;
  }

  .side-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    font-size: 0.9rem;
    color: var(--muted-on-dark);
  }

  .side-list li {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .side-bullet {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #4ade80;
    flex: none;
  }

  .side-alert {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    background: rgb(0 115 77 / 0.22);
    border: 1px solid rgb(0 115 77 / 0.4);
    border-radius: var(--radius-md);
    padding: 0.85rem 1rem;
    font-size: 0.82rem;
    color: #86efac;
    line-height: 1.45;
  }

  .alert-bolt {
    font-size: 1rem;
  }
</style>
